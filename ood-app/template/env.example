# nextpyp-ood-interactive — site config.
# Copy to `env` (same directory) and edit. The launcher sources this file.
# All variables are shell-style: KEY=value. Comments start with #.

# REQUIRED. Absolute path to the nextPYP install containing:
#   ${NEXTPYP_INSTALL}/nextPYP.sif
#   ${NEXTPYP_INSTALL}/sharedExec/containers/pyp.sif
#   ${NEXTPYP_INSTALL}/templates/default.peb
#   ${NEXTPYP_INSTALL}/workflows/
#   ${NEXTPYP_INSTALL}/nextpyp-host-processor
# Download from https://nextpyp.app/ per Duke Bartesaghi lab's instructions.
NEXTPYP_INSTALL=/opt/nextpyp

# Where per-user NextPYP data lives (projects, jobs, database, config).
# Must be on a shared filesystem visible from every compute node.
# Default follows the user home. Change only if $HOME isn't shared.
#NEXTPYP_HOME=$HOME/nextpyp

# Slurm partition NextPYP submits processing jobs to.
NEXTPYP_PARTITION=compute

# Comma-separated bind mounts for BOTH the launcher's apptainer exec and
# the generated config.toml's [pyp] binds. Include every host filesystem
# users need to read/write data from (raw movies, output dirs, scratch).
#NEXTPYP_BIND_MOUNTS=/scratch,/data,/home

# Optional: force a specific bind IP if the auto-detect (routing-table
# based) picks the wrong interface. Leave unset on most sites.
#NEXTPYP_BIND_IP=

# Fallback Slurm sizing if `sinfo` is unavailable or returns nothing
# for NEXTPYP_PARTITION. Adjust to match your typical compute node.
#NEXTPYP_FALLBACK_CPUS=4
#NEXTPYP_FALLBACK_MEM_MB=8192

# Cluster topology mode. Leave as `generic` unless you know you need
# CycleCloud dual-filesystem binds (see docs/CYCLECLOUD.md).
#CLUSTER_MODE=generic
